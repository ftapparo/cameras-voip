{
  "appId": "com.portaria.voip.camera",
  "productName": "Portaria VoIP Camera",
  "directories": {
    "buildResources": "public"
  },
  "files": [
    "dist/**",
    "electron-main.cjs",
    "preload.js",
    "public/**",
    "camera-proxy-server.mjs",
    "cameras.conf",
    "proxy-digest.js",
    "node_modules/express/**",
    "node_modules/cors/**",
    "node_modules/ini/**",
    "node_modules/ws/**",
    "!node_modules/**/test/**",
    "!node_modules/**/tests/**",
    "!node_modules/**/*.md",
    "!node_modules/**/README*",
    "!node_modules/**/CHANGELOG*",
    "!node_modules/**/.git*"
  ],
  "asarUnpack": [
    "preload.js",
    "camera-proxy-server.mjs",
    "cameras.conf",
    "proxy-digest.js",
    "node_modules/**/*"
  ],
  "compression": "maximum",
  "win": {
    "icon": "public/icon-512x512.png",
    "target": {
      "target": "nsis",
      "arch": ["x64"]
    },
    "forceCodeSigning": false,
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
