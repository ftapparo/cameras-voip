{
  "appId": "com.portaria.voip.camera",
  "productName": "Portaria VoIP Camera",
  "directories": {
    "buildResources": "public"
  },
  "files": [
    "dist/**",
    "electron-main.cjs",
    "public/**",
    "camera-proxy-server.mjs",
    "cameras.conf",
    "proxy-digest.js",
    "config-helper.mjs",
    "node_modules/express/**",
    "node_modules/cors/**",
    "node_modules/ini/**",
    "node_modules/ws/**"
  ],
  "asarUnpack": [
    "camera-proxy-server.mjs",
    "cameras.conf",
    "config-helper.mjs",
    "proxy-digest.js",
    "node_modules/**/*"
  ],
  "win": {
    "icon": "public/icon-512x512.png",
    "target": "nsis",
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false
  }
}
